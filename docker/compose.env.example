# Copy to docker/compose.env, then:
#   docker compose --env-file docker/compose.env up -d --force-recreate
#
# DSH_WORKSPACE = host folder mounted at /workspace.
# In the Web UI open /workspace/<project> (never D:/...).

DSH_IMAGE_TAG=0.2.1-alpha.10
DSH_HOST_PORT=3080
DSH_WORKSPACE=D:/Workspaces
DSH_DOCKER_BIND_ALL=1
# Host Maven repository (the folder holding com/, org/, ...) mounted at
# /m2/repository so Maven reuses its dependencies.
# DSH_MAVEN_REPO=C:/Users/<you>/.m2/repository
# Maven runs offline by default; uncomment (empty) to let it resolve online.
# MAVEN_ARGS=
# SSH keys for git over SSH (folder with the key, config, known_hosts). The agent
# can use them, so prefer a dedicated deploy key over a personal one.
# DSH_SSH_DIR=C:/Users/<you>/.ssh-dsh
# Company package mirrors (e.g. Nexus) for npm and pip.
# NPM_CONFIG_REGISTRY=https://nexus.company.local/repository/npm-group/
# PIP_INDEX_URL=https://nexus.company.local/repository/pypi-group/simple
# Empty disables the Web presets' Java lsp tool. Browser tools are the
# optional "Browser tools" bundle, switched on in Plugins.
# DSH_JDTLS=
DSH_TRUSTED_HOST=
DSH_CLIENT_COMMIT_HASH=0000000
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Do not set OLLAMA_API_KEY here — it blocks Settings → credentials.

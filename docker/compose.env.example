# Copy to docker/compose.env, then:
#   docker compose --env-file docker/compose.env up -d --force-recreate
#
# DSH_WORKSPACE = host folder mounted at /workspace.
# In the Web UI open /workspace/<project> (never D:/...).

DSH_IMAGE_TAG=0.2.1-alpha.7
DSH_HOST_PORT=3080
DSH_WORKSPACE=D:/Workspaces
DSH_DOCKER_BIND_ALL=1
DSH_TRUSTED_HOST=
DSH_CLIENT_COMMIT_HASH=0000000
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Do not set OLLAMA_API_KEY here — it blocks Settings → credentials.
